{
  "scripts": {
    "build:css": "tailwindcss -i ./frontend/styles/app.css -o ./backend/app/static/vendor/app.css --minify",
    "watch:css": "tailwindcss -i ./frontend/styles/app.css -o ./backend/app/static/vendor/app.css --watch",
    "copy:vendor": "node ./frontend/scripts/copy-vendor.mjs",
    "build:ui": "npm run build:css && npm run copy:vendor"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/poppins": "^5.3.0",
    "@tailwindcss/typography": "^0.5.15",
    "alpinejs": "^3.14.8",
    "chart.js": "^4.4.7",
    "daisyui": "^4.12.14",
    "htmx.org": "^1.9.12",
    "lucide": "^0.468.0",
    "tailwindcss": "^3.4.17"
  }
}
